# -------------------------------------------------------------
# ClubSync Server Environment Variables
# -------------------------------------------------------------

# Node Environment
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS whitelist and OAuth redirects)
CLIENT_URL=https://your-frontend-domain.com

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/clubsync?sslmode=require

# Database Connection Pool Tuning (Optional)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=20000

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-secure-random-32-byte-hex-or-base64-string

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Groq AI API Key for Constitution Q&A and Meeting Summaries (Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here

# SMTP Email Configuration for Notifications (Optional - falls back to Ethereal in test)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
